<xs:schema xmlns:schema="https://schema.org/" xmlns:swh="https://www.softwareheritage.org/schema/2018/deposit" xmlns:swhdeposit="https://www.softwareheritage.org/schema/2018/deposit" attributeFormDefault="unqualified" elementFormDefault="qualified" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:import schemaLocation="schema1.xsd" namespace="https://www.softwareheritage.org/schema/2018/deposit" />
  <xs:element name="root">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="articles_count" type="xs:unsignedShort" />
        <xs:element maxOccurs="unbounded" name="authors" type="xs:string" />
        <xs:element maxOccurs="unbounded" name="classification" type="xs:unsignedByte" />
        <xs:element ref="swhdeposit:deposit" />
        <xs:element name="dependencies" type="xs:string" />
        <xs:element name="description" type="xs:string" />
        <xs:element name="homepage" type="xs:string" />
        <xs:element name="id" type="xs:unsignedShort" />
        <xs:element maxOccurs="unbounded" name="keywords" type="xs:string" />
